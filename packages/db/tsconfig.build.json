{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "module": "node16",
    "moduleResolution": "node16",
    "verbatimModuleSyntax": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/index.ts", "src/schema/**/*.ts", "src/relations/**/*.ts"]
}
