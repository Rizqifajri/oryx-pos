# ── Core ───────────────────────────────────────────────────────
DATABASE_URL=postgres://user:pass@host/db
CORS_ORIGIN=http://localhost:3001
NODE_ENV=development

# ── Auth (JWT) ─────────────────────────────────────────────────
# Both secrets must be at least 32 chars. JWT_SECRET must match the
# web app's JWT_SECRET (apps/web/.env.local) or logins bounce to /login.
JWT_SECRET=change-me-to-a-long-random-string-min-32
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# ── Cloudflare R2 (image uploads) ──────────────────────────────
# From the Cloudflare dashboard: R2 → your bucket → Settings, and an
# R2 API token (Account → R2 → Manage API Tokens).
#   R2_ACCOUNT_ID     Cloudflare account id (used to build the S3 endpoint)
#   R2_ACCESS_KEY_ID  R2 API token access key id
#   R2_SECRET_ACCESS_KEY  R2 API token secret
#   R2_BUCKET_NAME    the bucket that holds uploads
#   R2_PUBLIC_URL     public base URL of the bucket, no trailing slash
#                     (enable r2.dev, or attach a custom domain)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
