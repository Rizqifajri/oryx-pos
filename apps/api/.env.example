# Copy to .env and fill in. Validated at startup by packages/env/src/server.ts.

# Postgres (Neon: use the pooled connection string)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
NODE_ENV=development

# The web app's origin (one origin only)
CORS_ORIGIN=http://localhost:3001

# Each at least 32 characters. JWT_SECRET must equal apps/web/.env.local.
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string-min-32
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Midtrans (required; sandbox keys: dashboard.sandbox.midtrans.com → Settings → Access Keys)
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_SERVER_KEY
MIDTRANS_CLIENT_KEY=SB-Mid-client-YOUR_CLIENT_KEY
MIDTRANS_IS_PRODUCTION=false
FRONTEND_URL=http://localhost:3001

# Cloudflare R2 for menu photos (optional; upload returns 503 without them)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
