{
  "name": "dio-sys",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.11.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=server",
    "dev:web": "turbo run dev --filter=dio-systems",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "db:push": "turbo run db:push --filter=@dio-sys-be/db",
    "db:studio": "turbo run db:studio --filter=@dio-sys-be/db",
    "db:generate": "turbo run db:generate --filter=@dio-sys-be/db",
    "db:migrate": "turbo run db:migrate --filter=@dio-sys-be/db",
    "db:seed": "turbo run db:seed --filter=@dio-sys-be/db"
  },
  "devDependencies": {
    "turbo": "^2.10.12"
  }
}
