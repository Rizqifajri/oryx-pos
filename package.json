{
  "name": "dio-sys",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev:api": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspaces --if-present",
    "check-types": "npm run check-types --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:push": "npm run db:push --workspace @dio-sys-be/db",
    "db:studio": "npm run db:studio --workspace @dio-sys-be/db",
    "db:generate": "npm run db:generate --workspace @dio-sys-be/db",
    "db:migrate": "npm run db:migrate --workspace @dio-sys-be/db",
    "db:seed": "npm run db:seed --workspace @dio-sys-be/db"
  }
}
